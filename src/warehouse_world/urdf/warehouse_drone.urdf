    </inertial>
  </link>
  <joint name="rf_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rf_right_link"/>
    <origin xyz="0.0 -0.15 0.0" rpy="0 0 -1.5708"/>
  </joint>
  <gazebo reference="rf_right_link">
    <sensor name="rf_right" type="gpu_lidar">
      <always_on>true</always_on>
