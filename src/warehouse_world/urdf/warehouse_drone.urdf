    </sensor>
  </gazebo>

  <link name="rf_front_left_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" iyy="0.000001" izz="0.000001"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rf_front_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rf_front_left_link"/>
    <origin xyz="0.11 0.11 0.0" rpy="0 0 0.7854"/>
  </joint>
  <gazebo reference="rf_front_left_link">
