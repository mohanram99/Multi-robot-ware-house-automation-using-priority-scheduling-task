  </link>
  <joint name="rf_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rf_left_link"/>
    <origin xyz="0.0 0.15 0.0" rpy="0 0 1.5708"/>
  </joint>
  <gazebo reference="rf_left_link">
