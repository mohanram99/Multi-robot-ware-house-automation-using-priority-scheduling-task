<?xml version="1.0"?>
<robot name="big_amr">

  <!-- ==================== -->
  <!--  MATERIALS           -->
  <!-- ==================== -->
  <material name="amr_blue">
    <color rgba="0.10 0.30 0.70 1.0"/>
  </material>
  <material name="amr_dark_grey">
    <color rgba="0.18 0.18 0.18 1.0"/>
  </material>
  <material name="amr_mid_grey">
    <color rgba="0.40 0.40 0.40 1.0"/>
  </material>
  <material name="orange_stripe">
    <color rgba="0.92 0.42 0.02 1.0"/>
  </material>
  <material name="lidar_blue">
    <color rgba="0.10 0.35 0.85 1.0"/>
  </material>

  <!-- ==================== -->
  <!--  BASE FOOTPRINT      -->
  <!-- ==================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
  </joint>

  <!-- ==================== -->
  <!--  MAIN BODY           -->
  <!-- ==================== -->
  <link name="base_link">
    <inertial>
      <mass value="55.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="4.0" iyy="5.0" izz="7.0"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>

    <!-- Main platform body — blue  -->
    <visual name="body_main">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.05 0.83 0.21"/>
      </geometry>
      <material name="amr_blue"/>
    </visual>

    <!-- Dark grey bottom skirt -->
    <visual name="body_skirt">
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <geometry>
        <box size="1.08 0.86 0.06"/>
      </geometry>
      <material name="amr_dark_grey"/>
    </visual>

    <!-- Orange safety stripes -->
    <visual name="stripe_front">
      <origin xyz="0.518 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.83 0.09"/>
      </geometry>
      <material name="orange_stripe"/>
    </visual>
    <visual name="stripe_rear">
      <origin xyz="-0.518 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.83 0.09"/>
      </geometry>
      <material name="orange_stripe"/>
    </visual>

    <!-- CARGO DECK — flat top for carrying row-1 big boxes -->
    <visual name="cargo_deck">
      <origin xyz="0 0 0.113" rpy="0 0 0"/>
      <geometry>
        <box size="1.02 0.80 0.015"/>
      </geometry>
      <material name="amr_mid_grey"/>
    </visual>

    <!-- Deck rim  -->
    <visual name="rim_front">
      <origin xyz="0.50 0 0.14" rpy="0 0 0"/>
      <geometry><box size="0.02 0.80 0.04"/></geometry>
      <material name="amr_dark_grey"/>
    </visual>
    <visual name="rim_rear">
      <origin xyz="-0.50 0 0.14" rpy="0 0 0"/>
      <geometry><box size="0.02 0.80 0.04"/></geometry>
      <material name="amr_dark_grey"/>
    </visual>

    <collision name="body_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.08 0.86 0.24"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== -->
  <!--  LIDAR (rear top)    -->
  <!-- ==================== -->
  <link name="lidar_mount">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="lidar_vis">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
      <material name="lidar_blue"/>
    </visual>
    <collision name="lidar_col">
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mount"/>
    <origin xyz="-0.42 0 0.155" rpy="0 0 0"/>
  </joint>

  <link name="base_scan"/>
  <joint name="scan_joint" type="fixed">
    <parent link="lidar_mount"/>
    <child link="base_scan"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ==================== -->
  <!--  BUMPERS             -->
  <!-- ==================== -->
  <link name="front_bumper">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.02"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="bumper_vis">
      <geometry><box size="0.03 0.78 0.12"/></geometry>
      <material name="amr_dark_grey"/>
    </visual>
    <collision name="bumper_col">
      <geometry><box size="0.03 0.78 0.12"/></geometry>
    </collision>
  </link>
  <joint name="front_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_bumper"/>
    <origin xyz="0.545 0 -0.02" rpy="0 0 0"/>
  </joint>

  <link name="rear_bumper">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.02"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="bumper_vis">
      <geometry><box size="0.03 0.78 0.12"/></geometry>
      <material name="amr_dark_grey"/>
    </visual>
    <collision name="bumper_col">
      <geometry><box size="0.03 0.78 0.12"/></geometry>
    </collision>
  </link>
  <joint name="rear_bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_bumper"/>
    <origin xyz="-0.545 0 -0.02" rpy="0 0 0"/>
  </joint>

  <!-- ==================== -->
  <!--  WHEELS (4, r=0.15)  -->
  <!-- ==================== -->
  <link name="wheel_fl">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.03" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="wheel_vis">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.09"/></geometry>
      <material name="amr_dark_grey"/>
    </visual>
    <collision name="wheel_col">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.09"/></geometry>
    </collision>
  </link>
  <joint name="wheel_fl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl"/>
    <origin xyz="0.33 0.465 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_fr">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.03" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="wheel_vis">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.09"/></geometry>
      <material name="amr_dark_grey"/>
    </visual>
    <collision name="wheel_col">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.09"/></geometry>
    </collision>
  </link>
  <joint name="wheel_fr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr"/>
    <origin xyz="0.33 -0.465 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rl">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.03" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="wheel_vis">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.09"/></geometry>
      <material name="amr_dark_grey"/>
    </visual>
    <collision name="wheel_col">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.09"/></geometry>
    </collision>
  </link>
  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl"/>
    <origin xyz="-0.33 0.465 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rr">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.03" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="wheel_vis">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.09"/></geometry>
      <material name="amr_dark_grey"/>
    </visual>
    <collision name="wheel_col">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.15" length="0.09"/></geometry>
    </collision>
  </link>
  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
    <origin xyz="-0.33 -0.465 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ==================== -->
  <!--  GAZEBO PLUGINS      -->
  <!-- ==================== -->

  
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_fl_joint</left_joint>
      <left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint>
      <right_joint>wheel_rr_joint</right_joint>
      <wheel_separation>0.93</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <odom_publish_frequency>20</odom_publish_frequency>
      <topic>/big_amr/cmd_vel</topic>
      <odom_topic>/model/big_amr/odometry</odom_topic>
      <frame_id>big_amr/odom</frame_id>
      <child_frame_id>big_amr/base_footprint</child_frame_id>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>wheel_fl_joint</joint_name>
      <joint_name>wheel_fr_joint</joint_name>
      <joint_name>wheel_rl_joint</joint_name>
      <joint_name>wheel_rr_joint</joint_name>
    </plugin>
  </gazebo>

  
  <gazebo reference="base_scan">
    <sensor name="big_amr_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <topic>/big_amr/scan</topic>
      <gz_frame_id>big_amr/base_scan</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.30</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="wheel_fl"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="wheel_fr"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="wheel_rl"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="wheel_rr"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>

</robot>
